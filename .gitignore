# Por defecto no se sube nada; solo se habilitan explícitamente
# los archivos del proyecto "Consola de Soporte CMQ".
*
!.gitignore
!Consola_Soporte_CMQ.html

!tablero/
tablero/*
!tablero/README.md
!tablero/DOCUMENTACION_TECNICA.md
!tablero/MANUAL_USUARIOS.md
!tablero/main.py
!tablero/run_local.py

# Contexto del skill "impeccable" (producto + sistema de diseño) — se sube para
# que persista entre sesiones/máquinas, ver tablero/PRODUCT.md y DESIGN.md.
!tablero/PRODUCT.md
!tablero/DESIGN.md
!tablero/.impeccable/
tablero/.impeccable/*
!tablero/.impeccable/design.json

# Nunca subir el token real ni los datos locales viejos (ver README).
tablero/token_local.json
tablero/kb_state.json
tablero/__pycache__/

# Cloudflare Worker (proxy de Jira en la nube) — el código sí se sube,
# el token vive como secreto en Cloudflare (wrangler secret put), nunca acá.
!worker/
worker/*
!worker/src/
worker/src/*
!worker/src/index.js
!worker/wrangler.toml
!worker/package.json
!worker/package-lock.json
# node_modules (se reinstala con "npm install") y .wrangler (cache local,
# puede contener tokens de sesión de "wrangler login") nunca se suben.
worker/node_modules/
worker/.wrangler/

# Firebase — reglas de Firestore versionadas (firestore.rules) y config de deploy
# (firebase.json) se suben. El secreto de Firebase (apiKey, etc.) nunca — vive
# hardcodeado en el HTML (es público en apps web) pero se valida server-side con
# las reglas de abajo.
!firestore.rules
!firebase.json
